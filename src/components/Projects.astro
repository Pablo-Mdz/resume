---
import { Image } from 'astro:assets';
import { projects, categories, type Category } from '../data/site';

const count = (id: string) =>
  id === 'all' ? projects.length : projects.filter((p) => p.categories.includes(id as Category)).length;
const labelFor = (id: string) => categories.find((c) => c.id === id)?.label ?? id;
// Under "All", only the first rows show until the visitor asks for the rest.
const FEATURED = 9;
---

<section class="work section" id="work">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow mono">Selected work · {String(projects.length).padStart(2, '0')}</p>
        <h2 class="section-title" data-reveal data-split>
          Selected projects
        </h2>
      </div>

      <div class="filters" role="group" aria-label="Filter projects" data-filters>
        {categories.map((c, i) => (
          <button class="filter" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {c.label}
            <sup>{count(c.id) || '—'}</sup>
          </button>
        ))}
      </div>
    </div>

    <ul class="grid" data-grid>
      {projects.map((p, i) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <li class="card" data-card data-categories={p.categories.join(' ')} data-extra={i >= FEATURED ? '' : undefined}>
            <Tag
              class="card__link"
              {...(p.href ? { href: p.href, target: '_blank', rel: 'noopener' } : {})}
              data-cursor={p.href ? 'View' : undefined}
            >
              <div class="card__media">
                <Image
                  src={p.image}
                  alt={`${p.title} — ${p.kind}`}
                  widths={[480, 720, 1000]}
                  sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 31vw"
                />
                <span class="card__cat mono">{p.categories.map(labelFor).join(' · ')}</span>
              </div>
              <div class="card__info">
                <span class="card__idx mono">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="card__title">
                    {p.title}
                    {p.href && <span class="arrow" aria-hidden="true">↗</span>}
                  </h3>
                  <p class="card__kind">{p.kind}</p>
                  {p.summary && <p class="card__summary">{p.summary}</p>}
                </div>
              </div>
              <ul class="card__stack" aria-label="Tech stack" translate="no">
                {p.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
            </Tag>
          </li>
        );
      })}

      <li class="card card--soon" data-card data-categories="ai" hidden>
        <div class="soon">
          <p class="mono">~/projects/ai $ <span class="caret" aria-hidden="true"></span></p>
          <h3 class="soon__title">More AI projects <span class="serif">on the way.</span></h3>
          <p class="soon__text">
            Complex apps built on solid fundamentals and accelerated with AI. New case studies are being added.
          </p>
        </div>
      </li>
    </ul>

    {projects.length > FEATURED && (
      <div class="more">
        <button class="btn more__btn" data-show-all hidden>
          Show all {projects.length} projects <span class="arrow" aria-hidden="true">↓</span>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--line-light);
    background: #fff;
  }

  .filter {
    position: relative;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    transition:
      background 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }

  .filter sup {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    margin-left: 0.2rem;
    color: var(--slate);
  }

  .filter:hover {
    background: rgb(176 179 198 / 0.3);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .filter[aria-pressed='true'] sup {
    color: var(--mist);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 4rem) clamp(1rem, 2.5vw, 2rem);
    align-items: start;
  }

  .card {
    will-change: transform;
  }

  .card.is-offset {
    margin-top: 5rem;
  }

  .card__link {
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    background: var(--mist);
    isolation: isolate;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transform: scale(1.02);
    transition:
      transform 1.1s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(26 27 75 / 0.55), transparent 45%);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .card__link:hover .card__media img {
    transform: scale(1.08);
  }

  .card__link:hover .card__media::after {
    opacity: 1;
  }

  .card__cat {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    z-index: 2;
    padding: 0.4rem 0.65rem;
    border-radius: 999px;
    background: rgb(245 246 250 / 0.9);
    backdrop-filter: blur(6px);
    font-size: 0.56rem;
  }

  .card__info {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-top: 1.1rem;
    border-bottom: 1px solid var(--line-light);
    padding-bottom: 0.9rem;
  }

  .card__idx {
    color: var(--slate);
    font-size: 0.6rem;
  }

  .card__title {
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.55rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .card__title .arrow {
    margin-left: 0.35rem;
    color: var(--indigo);
    font-size: 0.8em;
  }

  .card__kind {
    color: var(--slate);
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }

  .card__summary {
    margin-top: 0.6rem;
    color: var(--slate);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-top: 0.8rem;
    color: var(--indigo);
  }

  .card--soon {
    grid-column: span 2;
  }

  .soon {
    min-height: 22rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 14px;
    border: 1px dashed var(--indigo);
    background:
      radial-gradient(circle at 85% 20%, rgb(63 76 154 / 0.18), transparent 50%),
      var(--paper);
  }

  .soon .mono {
    color: var(--indigo);
  }

  .soon__title {
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }

  .soon__title .serif {
    color: var(--indigo);
  }

  .soon__text {
    color: var(--slate);
    max-width: 30rem;
  }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    vertical-align: -0.15em;
    background: var(--indigo);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      max-width: 100%;
      scrollbar-width: none;
    }
    .filter {
      padding: 0.55rem 0.8rem;
      flex-shrink: 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .card.is-offset {
      margin-top: 0;
    }
    .card--soon {
      grid-column: auto;
    }
  }
</style>
