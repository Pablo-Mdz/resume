---
import { articles, profile } from '../data/site';
const medium = profile.socials.find((s) => s.label === 'Medium')!.href;
---

<section class="writing section" id="writing">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow mono">Writing on Medium</p>
        <h2 class="section-title" data-reveal data-split>
          Case studies
        </h2>
      </div>
      <a href={medium} target="_blank" rel="noopener" class="btn">All articles <span class="arrow">↗</span></a>
    </div>

    <ul class="articles" data-articles>
      {articles.map((a, i) => (
        <li data-reveal data-fade-up>
          <a href={a.href} target="_blank" rel="noopener" class="article">
            <span class="article__num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="article__title">{a.title}</span>
            <span class="article__meta mono">{a.meta}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

</section>

<style>
  .articles {
    border-top: 1px solid var(--line-light);
  }

  .article {
    display: grid;
    grid-template-columns: 4rem 1fr 18rem 2rem;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line-light);
    transition:
      padding 0.5s var(--ease-out),
      color 0.3s;
  }

  .article:hover {
    padding-inline: 1rem;
    color: var(--indigo);
  }

  .article__num,
  .article__meta {
    color: var(--slate);
    font-size: 0.6rem;
  }

  .article__title {
    font-size: clamp(1.15rem, 0.9rem + 0.9vw, 1.75rem);
    font-weight: 550;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }


  @media (max-width: 860px) {
    .article {
      grid-template-columns: 2.5rem 1fr 1.5rem;
    }
    .article__meta {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
