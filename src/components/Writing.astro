---
import { Image } from 'astro:assets';
import { articles, profile } from '../data/site';
const medium = profile.socials.find((s) => s.label === 'Medium')!.href;
---

<section class="writing section" id="writing">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow mono">Writing on Medium</p>
        <h2 class="section-title" data-reveal data-split>
          Case <span class="serif">studies</span>
        </h2>
      </div>
      <a href={medium} target="_blank" rel="noopener" class="btn">All articles <span class="arrow">↗</span></a>
    </div>

    <ul class="articles" data-articles>
      {articles.map((a, i) => (
        <li data-reveal data-fade-up>
          <a href={a.href} target="_blank" rel="noopener" class="article" data-preview={i}>
            <span class="article__num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="article__title">{a.title}</span>
            <span class="article__meta mono">{a.meta}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="preview" aria-hidden="true" data-preview-float>
    {articles.map((a, i) => (
      <Image src={a.image} alt="" widths={[420]} sizes="21rem" data-preview-img={i} />
    ))}
  </div>
</section>

<style>
  .articles {
    border-top: 1px solid var(--line-light);
  }

  .article {
    display: grid;
    grid-template-columns: 4rem 1fr 18rem 2rem;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line-light);
    transition:
      padding 0.5s var(--ease-out),
      color 0.3s;
  }

  .article:hover {
    padding-inline: 1rem;
    color: var(--indigo);
  }

  .article__num,
  .article__meta {
    color: var(--slate);
    font-size: 0.6rem;
  }

  .article__title {
    font-size: clamp(1.15rem, 0.9rem + 0.9vw, 1.75rem);
    font-weight: 550;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: 21rem;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 30px 60px -20px rgb(26 27 75 / 0.5);
    background: var(--mist);
  }

  .preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .preview img.is-active {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .article {
      grid-template-columns: 2.5rem 1fr 1.5rem;
    }
    .article__meta {
      grid-column: 2;
      grid-row: 2;
    }
    .preview {
      display: none;
    }
  }

  @media (hover: none) {
    .preview {
      display: none;
    }
  }
</style>
