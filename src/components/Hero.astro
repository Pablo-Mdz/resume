---
import { Picture } from 'astro:assets';
import portrait from '../assets/photos/pablo-portrait.webp';
---

<section class="hero section--dark" id="top" data-hero>
  <div class="blueprint" aria-hidden="true"></div>

  <div class="hero__inner wrap">
    <div class="hero__meta mono" data-hero-fade>
      <span>Software Developer</span>
      <span class="hero__meta-mid">52.52° N, 13.40° E — Berlin</span>
      <span>Web · Mobile · UX/UI · AI</span>
    </div>

    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__hello mono" data-hero-fade>Hi, I’m</p>
        <h1 class="hero__name">
          <span class="line-mask"><span data-hero-line>Pablo Cigoy</span></span>
        </h1>
        <p class="hero__role" data-hero-fade>
          Software developer — full stack, mobile &amp; UX/UI, building further with AI.
        </p>
        <p class="hero__lead" data-hero-fade>
          I build apps <em class="serif">from zero</em>, knowing how every layer works — and use AI to go further,
          faster.
        </p>
        <div class="hero__actions" data-hero-fade>
          <a href="#work" class="btn btn--light" data-scroll-link>View projects <span class="arrow">↗</span></a>
          <a href="#contact" class="hero__link" data-scroll-link>Get in touch</a>
        </div>
      </div>

      <figure class="hero__photo" data-hero-photo>
        <div class="hero__photo-inner" data-parallax="-8">
          <Picture
            src={portrait}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          quality={50}
            alt="Portrait of Pablo Cigoy"
            widths={[400, 640, 900]}
            sizes="(max-width: 760px) 80vw, 34vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </figure>
    </div>

    <div class="hero__bottom">
      <div class="div-toy" data-div-toy data-hero-fade aria-hidden="true">
        <div class="div-toy__box"><span class="div-toy__dot"></span></div>
        <code class="div-toy__code">
          place-items: <b data-div-toy-value>start</b>;
        </code>
      </div>

      <a href="#manifesto" class="hero__scroll mono" data-scroll-link data-hero-fade>
        <span>Scroll</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 2rem;
    padding-top: 6.5rem;
    padding-bottom: 2rem;
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--mist);
    font-size: 0.62rem;
  }

  .hero__grid {
    align-self: center;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .hero__hello {
    color: var(--mist);
    margin-bottom: 1rem;
  }

  .hero__name {
    font-size: clamp(2.8rem, 1.5rem + 4.2vw, 5.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--paper);
  }

  .hero__role {
    margin-top: 1.25rem;
    font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.45rem);
    line-height: 1.35;
    color: var(--paper);
    max-width: 32rem;
    text-wrap: balance;
  }

  .hero__lead {
    margin-top: 1rem;
    max-width: 30rem;
    color: var(--mist);
    text-wrap: pretty;
  }

  .hero__lead em {
    color: var(--paper);
    font-size: 1.12em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .hero__link {
    font-weight: 600;
    border-bottom: 1px solid var(--mist);
    padding-bottom: 0.15rem;
    transition: border-color 0.3s;
  }

  .hero__link:hover {
    border-color: var(--paper);
  }

  .hero__photo {
    margin: 0;
    justify-self: end;
    width: min(100%, 26rem, 50svh);
  }

  .hero__photo-inner {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    background: var(--indigo);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  .hero__photo img {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }

  .hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.58rem;
    color: var(--mist);
  }

  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 3.5rem;
    background: var(--line-dark);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--paper);
    animation: drip 2s var(--ease-out) infinite;
  }

  @keyframes drip {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  /* the "yes, I can center a div" toy */
  .div-toy {
    display: grid;
    gap: 0.6rem;
  }

  .div-toy__box {
    width: 9rem;
    height: 5.5rem;
    border: 1px dashed var(--mist);
    border-radius: 6px;
    position: relative;
    background-image:
      linear-gradient(var(--line-dark) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-dark) 1px, transparent 1px);
    background-size: 50% 50%;
    background-position: center;
  }

  .div-toy__dot {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 4px;
    background: var(--paper);
  }

  .div-toy__code {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--mist);
  }

  .div-toy__code b {
    color: var(--paper);
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .hero__meta-mid {
      display: none;
    }
    .div-toy {
      display: none;
    }
    .hero__bottom {
      justify-content: end;
    }
  }

  @media (max-width: 760px) {
    .hero__inner {
      padding-top: 5.5rem;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero__photo {
      justify-self: start;
      width: min(80%, 20rem);
    }
    .hero__meta span:last-child {
      display: none;
    }
  }
</style>
