---
import { services } from '../data/site';
---

<section class="services section" id="services">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow mono">Services</p>
        <h2 class="section-title" data-reveal data-split>
          What I <span class="serif">do</span>
        </h2>
      </div>
    </div>

    <ol class="services__list">
      {services.map((s, i) => (
        <li class="service" data-reveal data-fade-up>
          <span class="service__num mono">0{i + 1}</span>
          <h3 class="service__title">{s.title}</h3>
          <div class="service__detail">
            <p>{s.text}</p>
            <ul>
              {s.tags.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services__list {
    border-top: 1px solid var(--ink);
  }

  .service {
    position: relative;
    display: grid;
    grid-template-columns: 5rem 1.1fr 1fr;
    gap: 2rem;
    align-items: start;
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
    border-bottom: 1px solid var(--ink);
    isolation: isolate;
  }

  .service::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    z-index: -1;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.6s var(--ease-out);
  }

  .service:hover::before {
    transform: scaleY(1);
  }

  .service:hover {
    color: var(--paper);
  }

  .service:hover .service__detail p,
  .service:hover .service__num {
    color: var(--mist);
  }

  .service:hover .chip {
    color: var(--mist);
  }

  .service__num {
    padding-top: 0.9rem;
    color: var(--slate);
    transition: color 0.4s;
  }

  .service__title {
    font-size: clamp(1.9rem, 1rem + 3vw, 4rem);
    font-weight: 700;
    font-stretch: 80%;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    transition: transform 0.6s var(--ease-out);
  }

  .service:hover .service__title {
    transform: translateX(0.75rem);
  }

  .service__detail p {
    color: var(--slate);
    margin-bottom: 1rem;
    transition: color 0.4s;
  }

  .service__detail ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--indigo);
  }

  @media (max-width: 860px) {
    .service {
      grid-template-columns: 3rem 1fr;
    }
    .service__detail {
      grid-column: 2;
    }
  }
</style>
